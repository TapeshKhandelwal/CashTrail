# Django API base (server-only). The BFF (/api/proxy, /api/auth) and Server Components call it.
API_URL=http://localhost:8000/api

# Same value as the backend's BFF_SHARED_SECRET. Lets Django throttle and audit by each
# browser's IP instead of this server's. Empty: Django sees this server's address.
BFF_SHARED_SECRET=

# Django API origin as the browser would see it; compiled into the service worker so API
# responses are never cached. The browser itself only talks to the BFF.
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Public site URL: metadataBase and share links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Service worker precache revision; bump on every deploy.
NEXT_PUBLIC_APP_VERSION=dev

# Show demo-role quick sign-in on /login and "Demo data" labels.
NEXT_PUBLIC_DEMO_MODE=true
