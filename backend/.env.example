# --- Django -------------------------------------------------------------------
# Long random string used for signing (JWTs, sessions). Never reuse across environments.
SECRET_KEY=change-me-to-a-long-random-string
# True only for local development; enables debug pages and disables HTTPS hardening.
DEBUG=True
# Comma-separated hostnames this API may be served from.
ALLOWED_HOSTS=localhost,127.0.0.1
# Minimum level for application logs (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO

# --- Database -----------------------------------------------------------------
# PostgreSQL connection string (add ?sslmode=require for hosted databases such as Neon).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cashtrail
# Seconds to keep database connections open between requests (0 = close after each request).
DB_CONN_MAX_AGE=60
# Optional: name of the throwaway database pytest creates; set a unique one per parallel run.
# TEST_DB_NAME=test_cashtrail

# --- HTTP / security ----------------------------------------------------------
# Frontend origins allowed to call the API from the browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Origins trusted for CSRF-protected requests (Django admin behind HTTPS).
CSRF_TRUSTED_ORIGINS=http://localhost:3000
# Redirect HTTP to HTTPS when DEBUG=False; disable only if the proxy already does it.
SECURE_SSL_REDIRECT=True
# HSTS max-age in seconds when DEBUG=False (default 30 days); 0 disables it.
SECURE_HSTS_SECONDS=2592000
# True only behind exactly one proxy that appends the client address to X-Forwarded-For
# (e.g. Render): the right-most entry is then used for throttling and the audit trail.
TRUST_X_FORWARDED_FOR=False
# Login attempts allowed per client IP, for the API and the Django admin (N/sec|min|hour|day).
LOGIN_THROTTLE_RATE=10/min
# Failed login attempts allowed per username, from any IP.
LOGIN_USERNAME_THROTTLE_RATE=5/min
# Shared with the frontend server (same value in frontend/.env.local). It sends each browser's
# IP in X-Client-IP; without a matching secret that header is ignored. Empty disables it.
BFF_SHARED_SECRET=
# Requests allowed per authenticated user.
USER_THROTTLE_RATE=600/min
# Cache shared by all workers (throttle counters). Defaults to a file cache in the system temp
# directory, shared by every process on one host. Across several hosts use Redis (redis://...),
# which also needs the `redis` package installed (it is not in requirements.txt).
# CACHE_URL=filecache:///tmp/cashtrail-cache

# --- Django admin -------------------------------------------------------------
# Serve the read-only Django admin (defaults to the value of DEBUG).
ADMIN_ENABLED=True
# Path the admin is served at; use a hard-to-guess one in production.
ADMIN_URL=admin/

# --- Authentication -----------------------------------------------------------
# Access token lifetime in minutes.
JWT_ACCESS_MINUTES=30
# Refresh token lifetime in days (refresh tokens rotate and are blacklisted on logout).
JWT_REFRESH_DAYS=1

# --- Business rules -----------------------------------------------------------
# Days a bank deposit may stay pending before it is flagged as a delayed settlement.
SETTLEMENT_SLA_DAYS=2
# Window in which the same loan + amount + agent is treated as a possible duplicate collection.
DUPLICATE_WINDOW_MINUTES=10

# --- Payment gateway (UPI) ----------------------------------------------------
# "mock" runs a built-in simulated gateway; "cashfree" and "razorpay" use the keys below.
PAYMENT_PROVIDER=mock

# Cashfree App ID (starts with TEST in the sandbox). Required when PAYMENT_PROVIDER=cashfree.
CASHFREE_APP_ID=
# Cashfree secret key: authenticates API calls and verifies x-webhook-signature.
CASHFREE_SECRET_KEY=
# "sandbox" (test keys, no real money) or "production".
CASHFREE_ENVIRONMENT=sandbox
# Optional. Public URL of /api/payments/webhooks/cashfree/, sent with every order so Cashfree
# reports payments even when the agent's screen is closed (https only in production).
CASHFREE_NOTIFY_URL=
# Optional. Where Cashfree sends the customer when its checkout cannot open as a pop-up
# ({order_id} is filled in), e.g. https://app.example.com/app/agent/collect/upi-return?order_id={order_id}
CASHFREE_RETURN_URL=

# Razorpay key id (starts with rzp_test_ in test mode). Required when PAYMENT_PROVIDER=razorpay.
RAZORPAY_KEY_ID=
# Razorpay key secret, used to create orders and verify checkout signatures.
RAZORPAY_KEY_SECRET=
# Secret configured on the Razorpay webhook, used to verify X-Razorpay-Signature.
RAZORPAY_WEBHOOK_SECRET=
